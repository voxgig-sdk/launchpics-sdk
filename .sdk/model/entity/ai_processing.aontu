# Entity: ai_processing

main: kit: entity: ai_processing: {

  alias: field: {}

  fields: [
    {
      name: "imageId"
      req: true
      type: "`$STRING`"
    }
    {
      name: "instruction"
      req: true
      type: "`$STRING`"
    }
    {
      name: "processedImageId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "ai_processing"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/process"
          parts: [
            "process"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
