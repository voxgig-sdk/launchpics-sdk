# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "Unique identifier for the uploaded image"
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "url"
      req: false
      short: "Unique URL to access the uploaded image"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "image"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/upload"
          parts: [
            "upload"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "image_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "height"
                orig: "height"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "width"
                orig: "width"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/images/{imageId}"
          parts: [
            "images"
            "{id}"
          ]
          rename: {
            param: {
              imageId: "id"
            }
          }
          select: {
            exist: [
              "format"
              "height"
              "id"
              "width"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "image_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/images/{imageId}"
          parts: [
            "images"
            "{id}"
          ]
          rename: {
            param: {
              imageId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
